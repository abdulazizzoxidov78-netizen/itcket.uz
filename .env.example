# ==========================================
# ELITE GLOBAL TICKETING PLATFORM - ENV EXAMPLE
# ==========================================

# Server & App
PORT=5000
NODE_ENV=development
APP_NAME=ELITE TICKETS
CURRENCY=UZS
BASE_URL=http://localhost:5000

# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
BOT_USERNAME=your_bot_username
ADMIN_ID=your_telegram_user_id
CONTACT_TEXT=Savollar va yordam uchun: @support

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/ticketing?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/ticketing?retryWrites=true&w=majority

# ImageKit (Cloud Storage)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_FOLDER=/tickets

# Security & Auth
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
TICKET_SIGNING_SECRET=replace_with_ticket_hash_secret

# Initial Admin Credentials (Created by seed script)
INITIAL_ADMIN_EMAIL=admin@elitetickets.uz
INITIAL_ADMIN_PASSWORD=AdminElite2026!
INITIAL_ADMIN_NAME=Adminstrator

# Payments (Click / Payme / Uzum)
PAYMENT_MODE=test
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=
